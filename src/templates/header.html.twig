{% set isRedesignedHeader = (redesignClass ?? '') == 'rd25' %}
{% block header %}
<header{% if isRedesignedHeader %} class="rd25-header"{% endif %}>
    <h1>
        {# Mobile: wyśrodkowany sygnet + napis "UD" jako link do strony głównej
           (na desktopie <h1> jest ukryte — patrz header.scss). #}
        <a href="/" aria-label="Uprzejmie Donoszę — strona główna">
            <img src="/img/ud-sygnet.svg" alt="Uprzejmie Donoszę" width="97" height="86">
            <span>UD</span>
        {% if general.isStaging %}<sup>[STG]</sup>{% elseif general.isProd %}{% else %}<sup>[DEV]</sup>{% endif %}
        </a>
    </h1>
    {% if isRedesignedHeader %}
    <div class="mpr-navbar">
        {% if navbarBack ?? false %}
        {# app/confirm: zamiast logo przycisk cofający o krok (history -1) #}
        <a class="mpr-navbar-logo mpr-navbar-back" href="javascript:history.back()" data-rel="back">{{ navbarBack }}</a>
        {% else %}
        <a class="mpr-navbar-logo" href="/"><img src="/img/ud-logo.svg" alt="Uprzejmie Donoszę" width="662" height="85"></a>
        {% endif %}
        {% if not (hideNavbarLinks ?? false) or not (hideNavbarCta ?? false) %}
        <nav class="mpr-navbar-links">
            {% if not (hideNavbarLinks ?? false) %}
            {% include '_public-nav.html.twig' %}
            {% endif %}
            {% if not (hideNavbarCta ?? false) %}
            {% if navbarCtaAction ?? false %}
            <a class="mpr-navbar-cta {{ navbarCtaClass ?? '' }}">{{ navbarCtaLabel ?? 'Aplikacja' }}</a>
            {% else %}
            <a class="mpr-navbar-cta" href="{{ navbarCtaHref ?? '/app' }}">{{ navbarCtaLabel ?? 'Aplikacja' }}</a>
            {% endif %}
            {% endif %}
        </nav>
        {% endif %}
    </div>
    {% endif %}
    {% block menu %}
    {% include('_menu.html.twig') %}
    {% endblock %}
</header>
{% endblock %}
