{% set leftButton = 'menu' %}
{% set rightButton = 'menuStart' %}
{# SITEMAP-PRIORITY:0.1 #}

{% set mainClass = 'app' %}
{% set hasSidebar = true %}
{% set hideNavbarLinks = true %}
{% set navbarCtaHref = '/app/new' %}
{% set navbarCtaLabel = 'Nowe zgłoszenie' %}
{% set showAppNav = true %}

{% extends "base.html.twig" %}

{% block footer %}{% endblock %}

{% block sidebar %}
<aside class="mpr-sidebar mpr-sidebar--toc">
<details open>
<summary>Menu</summary>
{% include('_app-menu.html.twig') %}
</details>
</aside>
{% endblock %}

{% block main %}

<div class="dashboard-intro">
    <h1>Cześć {{ general.userName }},</h1>
    <p>{{ levels[general.stats.level].introMsg | raw }}</p>
</div>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoja ranga</div>
    <div class="rank-stepper">
        {% for levelId,levelDef in levels %}
        {% if not loop.first %}<div class="rank-connector"></div>{% endif %}
        <div class="rank-step {% if general.stats.level == levelId %}active{% endif %}">
            <div class="rank-dot">{{ loop.index }}</div>
            <span>{{ config.sex[levelDef.desc] }}</span>
        </div>
        {% endfor %}
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoje statystyki</div>
    <div class="stats-grid">

        {% set active = general.stats.active ?? 0 %}
        {% set fined = general.stats['confirmed-fined'] ?? 0 %}
        {% set instructed = general.stats['confirmed-instructed'] ?? 0 %}
        <div class="stat-card">
            {% if active > 0 %}
            <a href="/app/list">
                <strong>{{ active|number_format(0, ',', ' ') }}</strong>
                <span>Aktywne zgłoszenia</span>
            </a>
            {% else %}
            <strong><a href="/app/new">Stwórz pierwsze</a></strong>
            <span>Aktywne zgłoszenia</span>
            {% endif %}
        </div>
        <div class="stat-card">
            {% if fined > 0 %}
            <a href="/app/list#confirmed-fined">
                <strong>{{ fined|number_format(0, ',', ' ') }}</strong>
                <span>Mandaty</span>
            </a>
            {% else %}
            <strong>0</strong>
            <span>Mandaty</span>
            {% endif %}
        </div>
        <div class="stat-card">
            {% if instructed > 0 %}
            <a href="/app/list#confirmed-instructed">
                <strong>{{ instructed|number_format(0, ',', ' ') }}</strong>
                <span>Pouczenia</span>
            </a>
            {% else %}
            <strong>0</strong>
            <span>Pouczenia</span>
            {% endif %}
        </div>
        <div class="stat-card">
            <strong>{{ (general.stats.points ?? 0)|number_format(0, ',', ' ') }}</strong>
            <span>Punkty karne</span>
        </div>
        <div class="stat-card stat-card-highlight">
            <strong>{{ (general.stats.mandates ?? 0)|number_format(0, ',', ' ') }} zł</strong>
            <span>Kwota mandatów</span>
        </div>
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoje odznaki</div>
    <div class="badges-grid">
        {% for badgeId,badge in badges %}
        {% set former_patron = (badgeId == 'patron' and 'former_patron' in general.stats.badges) %}
        <dialog data-role="popup" id="popup-badge-{{ badgeId }}">
            <p>{{ badge.desc|raw }}</p>
        </dialog>
        <a href="#popup-badge-{{ badgeId }}" data-rel="popup" class="badge-item">
            <div class="badge-circle {% if badgeId in general.stats.badges %}active{% endif %} {% if former_patron %}former_patron{% endif %}">
                <img src="{{ badge.img }}">
            </div>
            <span>
            {% if former_patron %}
                {{ config.sex['Była patronka'] }} ☹︎
            {% else %}
                {{ config.sex[badge.name] }}
            {% endif %}
            </span>
        </a>
        {% endfor %}
    </div>
</section>

<h3>Nie chcesz „donosić”? Dowiedz się, co możesz zrobić</h3>

<p>Napisz <a href="/napisz-pismo-do-polityka.html">pismo do polityka</a> w trzy minuty
    i przełóż swoją frustrację w realne działania.</p>

<p>Zapoznaj się z
    <a href="https://agendaparkingowa.pl/"
        target="_blank"
        rel="external">Miejską Agendą Parkingową</a>
    i dowiedz się jak niewielkie
    zmiany w przepisach mogą sprawić, że Uprzejmie Donoszę nie będzie potrzebne.
</p>

<div class="images-slider">
    <div class="imageContainer">
        <a href="https://agendaparkingowa.pl/"
            target="_blank"
            rel="external">
            <img src="/img/agenda-parkingowa-media-1.webp?width=250"
                data-src="/img/agenda-parkingowa-media-1.jpeg"
                class="lazyload" />
        </a>
    </div>
    <div class="imageContainer">
        <a href="https://agendaparkingowa.pl/"
            target="_blank"
            rel="external">
            <img src="/img/agenda-parkingowa-media-4.webp?width=250"
                data-src="/img/agenda-parkingowa-media-4.jpeg"
                class="lazyload" />
        </a>
    </div>
</div>

{% if 'patron' in general.stats.badges %}

<p>Zachęcam też do poparcia mojego
    <a href="https://www.change.org/Rowne-Prawa-Dla-Pieszych-i-Kierowcow/"
        target="_blank"
        rel="external">wniosku do Rzecznika Praw Obywatelskich</a>.
</p>

{% else %}

<p>Możesz też wesprzeć Uprzejmie Donoszę i Agendę Parkingową na Patronite.
    Chciałbym poświęcić więcej czasu swojej misji odzyskania przestrzeni dla
    pieszych. Twoje wsparcie bardzo mi w tym pomoże.
</p>

<a href="/patronite.html"
    class="patronite button">
    Dołącz do {{ config.stats.patrons }} Patronek i Patronów!
</a>

<p>
    Nie chcesz subskrybcji?
    <a href="https://suppi.pl/uprzejmiedonosze"
        target="_blank"
        rel="external">Suppi pozwala na jednorazową wpłatę niewielkiej kwoty</a>
    (za którą z góry dziękuję).
</p>
{% endif %}

{% endblock %}
