{# SITEMAP-PRIORITY:0.1 #}
{% set layout = 'app' %}
{% set mainClass = 'app' %}
{% set navbarCtaHref = '/app/new' %}
{% set navbarCtaLabel = 'Nowe zgłoszenie' %}

{% extends "base.html.twig" %}

{% block main %}

<div class="dashboard-intro">
    <h1>Cześć {{ general.userName }},</h1>
    <p>{{ levels[general.stats.level].introMsg | raw }}</p>
</div>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoja ranga</div>
    <div class="rank-stepper">
        {% for levelId,levelDef in levels %}
        {% if not loop.first %}<div class="rank-connector"></div>{% endif %}
        <div class="rank-step {% if general.stats.level == levelId %}active{% endif %}">
            <div class="rank-dot">{{ loop.index }}</div>
            <span>{{ config.sex[levelDef.desc] }}</span>
        </div>
        {% endfor %}
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoje statystyki</div>
    <div class="stats-grid">

        {% set active = general.stats.active ?? 0 %}
        {% set fined = general.stats['confirmed-fined'] ?? 0 %}
        {% set instructed = general.stats['confirmed-instructed'] ?? 0 %}
        <div class="stat-card">
            {% if active > 0 %}
            <a href="/app/list">
                <strong>{{ active|number_format(0, ',', ' ') }}</strong>
                <span>Aktywne zgłoszenia</span>
            </a>
            {% else %}
            <strong><a href="/app/new">Stwórz pierwsze</a></strong>
            <span>Aktywne zgłoszenia</span>
            {% endif %}
        </div>
        <div class="stat-card">
            {% if fined > 0 %}
            <a href="/app/list#confirmed-fined">
                <strong>{{ fined|number_format(0, ',', ' ') }}</strong>
                <span>Mandaty</span>
            </a>
            {% else %}
            <strong>0</strong>
            <span>Mandaty</span>
            {% endif %}
        </div>
        <div class="stat-card">
            {% if instructed > 0 %}
            <a href="/app/list#confirmed-instructed">
                <strong>{{ instructed|number_format(0, ',', ' ') }}</strong>
                <span>Pouczenia</span>
            </a>
            {% else %}
            <strong>0</strong>
            <span>Pouczenia</span>
            {% endif %}
        </div>
        <div class="stat-card">
            <strong>{{ (general.stats.points ?? 0)|number_format(0, ',', ' ') }}</strong>
            <span>Punkty karne</span>
        </div>
        <div class="stat-card stat-card-highlight">
            <strong>{{ (general.stats.mandates ?? 0)|number_format(0, ',', ' ') }} zł</strong>
            <span>Kwota mandatów</span>
        </div>
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Twoje odznaki</div>
    {# flat-illustration badge SVGs (src/img/badges/) - full color, don't
       tint with currentColor, unlike the dashboard's other line icons. #}
    {% set badgeIcons = {
        'green': '/img/badges/green.svg',
        'zebra': '/img/badges/zebra.svg',
        'bus': '/img/badges/bus.svg',
        'bike': '/img/badges/bike.svg',
        'patron': '/img/badges/patron.svg',
        'writer': '/img/badges/writer.svg'
    } %}
    <div class="badges-grid">
        {% for badgeId,badge in badges %}
        {% set former_patron = (badgeId == 'patron' and 'former_patron' in general.stats.badges) %}
        <dialog data-role="popup" id="popup-badge-{{ badgeId }}" class="badge-popup">
            {% if badgeIcons[badgeId] is defined %}<img src="{{ badgeIcons[badgeId] }}" alt="" class="badge-popup-icon">{% endif %}
            <p>{{ badge.desc|raw }}</p>
        </dialog>
        <a href="#popup-badge-{{ badgeId }}" data-rel="popup" class="badge-item">
            <div class="badge-circle {% if badgeId in general.stats.badges %}active{% endif %} {% if former_patron %}former_patron{% endif %}">
                {% if badgeIcons[badgeId] is defined %}<img src="{{ badgeIcons[badgeId] }}" alt="">{% endif %}
            </div>
            <span>
            {% if former_patron %}
                {{ config.sex['Była patronka'] }} ☹︎
            {% else %}
                {{ config.sex[badge.name] }}
            {% endif %}
            </span>
        </a>
        {% endfor %}
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-eyebrow">Nie chcesz „donosić”?</div>
    <p class="dashboard-section-lead">Dowiedz się, co jeszcze możesz zrobić.</p>
    <div class="support-grid">
        <a href="/napisz-pismo-do-polityka.html" class="support-card">
            <div class="support-card-title">Napisz pismo do polityka <span aria-hidden="true">&rarr;</span></div>
            <p>W trzy minuty przełóż swoją frustrację w realne działanie.</p>
        </a>
        <a href="https://agendaparkingowa.pl/" target="_blank" rel="external" class="support-card">
            <div class="support-card-title">Miejska Agenda Parkingowa <span aria-hidden="true">&#8599;</span></div>
            <p>Poznaj zmiany w przepisach, po których Uprzejmie Donoszę nie będzie potrzebne.</p>
        </a>

    {% if 'patron' in general.stats.badges %}
        <a href="https://www.change.org/Rowne-Prawa-Dla-Pieszych-i-Kierowcow/" target="_blank" rel="external" class="support-card">
            <div class="support-card-title">Wniosek do RPO <span aria-hidden="true">&#8599;</span></div>
            <p>Poprzyj mój wniosek do Rzecznika Praw Obywatelskich o równe prawa dla pieszych i kierowców.</p>
        </a>
    {% else %}
        <a href="/patronite.html" class="support-card">
            <div class="support-card-title">Patronite <span aria-hidden="true">&rarr;</span></div>
            <p>Utrzymanie serwerów kosztuje. Dołącz do {{ config.stats.patrons }} Patronek i Patronów i pomóż nam działać stabilnie.</p>
        </a>
        <a href="https://suppi.pl/uprzejmiedonosze" target="_blank" rel="external" class="support-card">
            <div class="support-card-title">Suppi <span aria-hidden="true">&#8599;</span></div>
            <p>Nie chcesz subskrypcji? Postaw nam kawę jednorazową, niewielką wpłatą.</p>
        </a>
    {% endif %}
    </div>
</section>

{% endblock %}
