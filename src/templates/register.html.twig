{# Zarejestrowany użytkownik (edycja konta) dostaje pełny widok /app z menu i
   tabbarem. Pierwsza rejestracja (onboarding, user jeszcze niezarejestrowany)
   idzie w trybie „focus" — tabbar/sidebar prowadziłyby do stron wymagających
   rejestracji, więc byłyby ślepą uliczką. #}
{% set layout = user.isRegistered ? 'app' : 'focus' %}
{% set appShell = true %}{# tło sekcji /app także w wariancie focus (onboarding) #}
{% set title = user.isRegistered ? 'Zaktualizuj konto' : 'Zarejestruj się' %}
{% set navbarCtaHref = '/app/new' %}
{% set navbarCtaLabel = 'Nowe zgłoszenie' %}

{% extends "base.html.twig" %}

{% block main %}

<form action="/app/register-ok?next={{ signInSuccessUrl ?? '/app/start' }}" id="register-form" method="post">
    <h2>Dane konta</h2>
    <p>Aby dokonać zgłoszenia musisz podać swoje imię, nazwisko, adres e-mail oraz adres korespondencyjny.
        Jest to minimalny zestaw informacji jakich wymaga SM do przyjęcia zgłoszenia.</p>
    <p>
        Dane oznaczone ikoną <span class="encrypted"></span> są zaszyfrowane dla twojego bezpieczeństwa.
        Dowiedz się więcej o <a target="_blank" href="/bezpieczenstwo.html">bezpieczeństwie twoich danych</a>.
    </p>

    <fieldset>
    <label for="name">Imię i nazwisko, które posłużą SM do identyfikacji autora zgłoszenia</label>
    <input type="text" required maxlength="30" id="name" name="name"
        placeholder="(twoje imię i nazwisko)" data-type="encrypted"
        value="{{ user.data.name }}" />

    <label>Płeć — wpływa na formy gramatyczne w generowanych pismach</label>
    <fieldset class="grid static3" data-sex="{{ user.data.sex ?? '?' }}">
        <input type="radio" name="sex" id="sex-m" value="m" {% if user.data.sex == 'm' %}checked="checked"{% endif %} required>
        <label for="sex-m" class="radio">mężczyzna</label>
        <input type="radio" name="sex" id="sex-f" value="f" {% if user.data.sex == 'f' %}checked="checked"{% endif %}>
        <label for="sex-f" class="radio">kobieta</label>
        <input type="radio" name="sex" id="sex-x" value="?" {% if user.data.sex != 'm' and user.data.sex != 'f' %}checked="checked"{% endif %}>
        <label for="sex-x" class="radio">nieokreślona</label>
    </fieldset>

    <label for="email">E-mail został pobrany automatycznie w trakcie logowania</label>
    <input disabled type="email" required maxlength="30" id="email" name="email"
        placeholder="(twój email)"
        value="{{ user.data.email }}" />

    <label for="address">Adres zamieszkania wraz z <b>numerem lokalu i miastem</b></label>
    <input type="text" maxlength="70" required id="address" name="address"
        placeholder="(Ulica 10a/7, Miasto)"
        autocomplete="off"  data-type="encrypted"
        value="{{ user.data.address ?? '' }}" />

    <label for="msisdn">Numer kontaktowy (opcjonalny, ale ułatwi SM kontakt z Tobą)</label>
    <input type="tel" maxlength="12" id="msisdn" name="msisdn"
        placeholder="666 666 666"  data-type="encrypted"
        data-inline="true" value="{{ user.data.msisdn ?? '' }}" />

    <label for="edelivery">Adres
        <a href="https://info.mobywatel.gov.pl/aktualnosci/loguj-sie-do-e-doreczen-aplikacja-mobywatel"
            target="_blank" rel="external">e-Doręczeń</a>
        (opcjonalny)</label>
    <input type="tel" id="edelivery" name="edelivery"
        maxlength="26" minlength="26"  data-type="encrypted"
        placeholder="AE:PL-00000-00000-AAAAA-00"
        value="{{ user.data.edelivery ?? '' }}" />

    </fieldset>

    <h3>Ustawienia</h3>

    <fieldset class="grid">
        <legend for="shareRecydywa">Chcę pozwalać na prezentowanie moich zdjęć w galerii recydywistów parkowania</legend>
        <input type="radio" name="shareRecydywa" id="shareRecydywa-Y" value="Y" {% if  user.shareRecydywa %}checked="checked"{% endif %}>
        <label for="shareRecydywa-Y" class="radio">
            tak (domyślnie), chcę udostępniać <u>pierwsze</u> zdjęcie każdego zgłoszenia
        </label>
        <input type="radio" name="shareRecydywa" id="shareRecydywa-N" value="N" {% if not user.shareRecydywa %}checked="checked"{% endif %}>
        <label for="shareRecydywa-N" class="radio">
            nie, moje zdjęcie ma być bardzo mocno „rozpikselowane”
        </label>
    </fieldset>

    <a id="register-submit" class="button cta last">
        Potwierdź
    </a>
</form>

{% if user.isRegistered %}
{# Same .connected-app(s) classes as /mcp's "Połączone aplikacje" — same
   kind of list (per-item card + a plain .button destructive action), so it
   stays visually aligned with that page (and picks up any future styling
   of those classes automatically). #}
<hr>
<section id="passkeys-section" class="connected-apps">
    <h3>Passkeye</h3>
    <p>Zaloguj się odciskiem palca, twarzą lub kodem PIN — bez hasła i bez sprawdzania poczty.</p>

    <ul id="passkeys-list" class="connected-apps-list">
        {% for passkey in passkeys %}
        <li class="connected-app" data-id="{{ passkey.credential_id }}">
            <span class="connected-app-name">{{ passkey.label }}</span>
            <span class="connected-app-meta">dodano {{ passkey.created_at|date('d.m.Y') }}{% if passkey.last_used_at %}, ostatnio użyto {{ passkey.last_used_at|date('d.m.Y') }}{% endif %}</span>
            <button type="button" class="button small passkey-remove" data-id="{{ passkey.credential_id }}">Usuń</button>
        </li>
        {% else %}
        <li class="passkeys-empty muted">Nie masz jeszcze żadnego passkeya.</li>
        {% endfor %}
    </ul>

    <button type="button" id="passkey-add" class="button" hidden>Dodaj passkey</button>
</section>

{# Na mobile /app nie ma już burgera (tabbar zastępuje nawigację), więc wylogowanie
   mieszka tu. Na desktopie tę akcję niesie sidebar _app-menu — stąd tylko mobile. #}
<hr class="app-mobile-only">
<p class="app-mobile-only app-account-logout">
    <a href="/logout.html">Wyloguj się</a>
</p>

<hr>
<section id="danger-zone">
    <h3>Strefa niebezpieczna</h3>
    <p>Skasowanie konta jest nieodwracalne.</p>
    {% if deleteError %}
    <p class="error">Wpisany adres e-mail nie zgadza się z adresem Twojego konta. Spróbuj ponownie.</p>
    {% endif %}
    <p class="app-account-delete">
        <a data-rel="popup" href="#delete-account-popup">Skasuj konto</a>
    </p>
</section>

<dialog data-role="popup" id="delete-account-popup">
    <form method="post" action="/app/delete-account" id="delete-account-form">
        <input type="hidden" name="csrf" value="{{ deleteCsrf }}">
        <h3>Skasuj konto</h3>
        <p>Co to oznacza:</p>
        <ol>
            <li>Twoje dane osobowe, zgłoszenia i zdjęcia zostaną usunięte z naszych serwerów.</li>
            <li>Kompletne usunięcie danych z backupów i logów nastąpi w ciągu 14 dni (okres retencji).</li>
            <li>Jeśli chcesz, będziesz mógł/mogła założyć nowe konto, logując się ponownie na uprzejmiedonosze.net.</li>
        </ol>
        <label for="delete-account-email">Aby potwierdzić, wpisz swój adres e-mail: <b>{{ user.data.email }}</b></label>
        <input type="email" id="delete-account-email" name="email" autocomplete="off"
               data-expected="{{ user.data.email }}">
        <button type="submit" id="delete-account-submit" class="button" disabled>Skasuj konto</button>
    </form>
</dialog>
{% endif %}

{% endblock %}
