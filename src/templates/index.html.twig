{# SITEMAP-PRIORITY:1.0 #}
{% set layout = 'main' %}
{% set mainClass = 'mainPage' %}

{% extends "base.html.twig" %}

{% block main %}

<div class="main-page-redesign">

    <section class="mpr-hero">
        <div class="mpr-hero-inner">
            <div class="mpr-hero-copy">
                <div class="mpr-hero-badge">
                    {{ config.stats.apps|number_format(0, ',', ' ') }} zgłoszeń wysłanych i liczymy dalej
                </div>
                <h1>Pomagamy walczyć z&nbsp;<em>nielegalnym parkowaniem</em></h1>
                <p class="mpr-lead">
                    Widzisz auto na chodniku, pasach albo trawniku? Zrób dwa zdjęcia &ndash;
                    wygenerujemy prawidłowe zgłoszenie i wyślemy je do właściwej straży
                    miejskiej w niecałą minutę.
                </p>
                <div class="mpr-cta-row">
                    <a href="/app/new" class="mpr-button mpr-button-primary">
                        Zgłoś nieprawidłowe parkowanie
                    </a>
                    <a href="#jak-to-dziala" class="mpr-button mpr-button-secondary">
                        Zobacz, jak to działa
                    </a>
                </div>
            </div>

            <div class="mpr-hero-visual">
                <div class="mpr-hero-visual-frame">
                    <img src="/img/hero.jpg?width=1200&as=jpg&quality=85" alt="">
                </div>
                <div class="mpr-hero-card mpr-hero-card-report">
                    <div class="mpr-hero-card-label">
                        <span>NOWE ZGŁOSZENIE</span>
                        <span>Wysłane</span>
                    </div>
                    <div class="mpr-hero-card-plate">
                        <span class="mpr-hero-card-plate-pl">PL</span>
                        <span class="mpr-hero-card-plate-number">WE1CF48</span>
                    </div>
                    <div class="mpr-hero-card-address">Henryka Pobożnego 11, Szczecin</div>
                    <div class="mpr-hero-card-reason">Pojazd jechał wzdłuż chodnika</div>
                    <div class="mpr-hero-card-sent">
                        <span>Wysłano do</span>
                        <strong>👮‍♀️ KP Szczecin Niebuszewo</strong>
                    </div>
                </div>
                <div class="mpr-hero-card mpr-hero-card-stat">
                    <strong>58 s</strong>
                    <span>czas zgłoszenia</span>
                </div>
            </div>
        </div>
    </section>

    <section class="mpr-trust-band">
        <div>
            <strong>{{ (config.stats.apps / 1000)|round|number_format(0, ',', ' ') }} tys.</strong>
            <span>wysłanych zgłoszeń</span>
        </div>
        <div>
            <strong>{{ (config.stats.users / 1000)|round|number_format(0, ',', ' ') }} tys.</strong>
            <span>aktywnych użytkowników</span>
        </div>
        <div>
            <strong>{{ config.stats.sm }}</strong>
            <span>obsługiwanych miejscowości</span>
        </div>
    </section>

    <section class="mpr-section" id="jak-to-dziala">
        <h2 class="mpr-section-title">Jak to działa</h2>
        <p style="text-align:center;color:#6b7871;margin:-0.5rem 0 2rem">Trzy kroki. Bez formularzy, bez znajomości przepisów.</p>
        <div class="mpr-steps">
            <div class="mpr-step">
                <div class="mpr-step-number">1</div>
                <h3>Zrób zdjęcia</h3>
                <p>Sfotografuj pojazd i wykroczenie. Wystarczą dwa ujęcia z telefonu.</p>
            </div>
            <div class="mpr-step">
                <div class="mpr-step-number">2</div>
                <h3>Sprawdź dane</h3>
                <p>Automatycznie odczytamy tablicę rejestracyjną i ustalimy adres zdarzenia.</p>
            </div>
            <div class="mpr-step">
                <div class="mpr-step-number">3</div>
                <h3>Wyślij zgłoszenie</h3>
                <p>Trafi do właściwego oddziału straży miejskiej. Ty dostaniesz potwierdzenie.</p>
            </div>
        </div>
    </section>

    <section class="mpr-demo-section">
        <div class="mpr-demo-head">
            <h2 class="mpr-section-title">Zobacz UD w akcji</h2>
            <p class="mpr-demo-sub">Rzeczywiste kroki tworzenia zgłoszenia &ndash; od zdjęcia po wysyłkę.</p>
        </div>
        <div class="mpr-demo-inner" data-demo>
            <div class="mpr-demo-steps">
                <button type="button" class="mpr-demo-step is-active" data-demo-step="0">
                    <div class="mpr-demo-step-head">
                        <span class="mpr-demo-step-num">1</span>
                        <span class="mpr-demo-step-label">Dodaj zdjęcia</span>
                    </div>
                    <div class="mpr-demo-progress"><span class="mpr-demo-progress-bar"></span></div>
                </button>
                <button type="button" class="mpr-demo-step" data-demo-step="1">
                    <div class="mpr-demo-step-head">
                        <span class="mpr-demo-step-num">2</span>
                        <span class="mpr-demo-step-label">Sprawdź dane</span>
                    </div>
                    <div class="mpr-demo-progress"><span class="mpr-demo-progress-bar"></span></div>
                </button>
                <button type="button" class="mpr-demo-step" data-demo-step="2">
                    <div class="mpr-demo-step-head">
                        <span class="mpr-demo-step-num">3</span>
                        <span class="mpr-demo-step-label">Potwierdź zgłoszenie</span>
                    </div>
                    <div class="mpr-demo-progress"><span class="mpr-demo-progress-bar"></span></div>
                </button>
                <p class="mpr-demo-caption" data-demo-caption>Fotografujesz wykroczenie i cały pojazd &ndash; aplikacja prowadzi Cię krok po kroku.</p>
            </div>

            <div class="mpr-demo-phone">
                <div class="mpr-demo-phone-frame">
                    <div class="mpr-demo-shot is-active" data-demo-shot="0">
                        <img src="/img/demo-1.png?width=720&as=webp&quality=82" alt="Dodawanie zdjęć do zgłoszenia" loading="lazy">
                    </div>
                    <div class="mpr-demo-shot" data-demo-shot="1">
                        <img src="/img/demo-2.png?width=720&as=webp&quality=82" alt="Weryfikacja danych zgłoszenia" loading="lazy">
                    </div>
                    <div class="mpr-demo-shot" data-demo-shot="2">
                        <img src="/img/demo-3.png?width=720&as=webp&quality=82" alt="Wysyłanie zgłoszenia do straży miejskiej" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mpr-section mpr-section-why">
        <h2 class="mpr-section-title">Dlaczego Uprzejmie Donoszę</h2>
        <div class="mpr-checklist">
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Generujemy prawidłowe i kompletne zgłoszenie</span>
            </div>
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Wysyłamy do właściwego oddziału SM/Policji w całej Polsce</span>
            </div>
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Twoje dane osobowe są bezpiecznie zaszyfrowane</span>
            </div>
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Całość zajmuje dosłownie minutę</span>
            </div>
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Ułatwiamy życie Tobie i służbom</span>
            </div>
            <div class="mpr-checklist-item">
                <span class="mpr-check-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>Walczymy o zmianę przepisów</span>
            </div>
        </div>
    </section>

    <section class="mpr-section" id="zabijmy-aplikacje">
        <h2 class="mpr-section-title">Nie chcesz „donosić”?</h2>
        <p style="text-align:center;color:#6b7871;margin:-0.5rem 0 2rem">Możesz działać u źródła. Zobacz, co jeszcze możesz zrobić.</p>
        <div class="mpr-cards mpr-cards-2">
            <a href="/napisz-pismo-do-polityka.html" class="mpr-link-card">
                <div class="mpr-link-card-title">Napisz pismo do polityka &rarr;</div>
                <p>W trzy minuty przełóż swoją frustrację w realne działanie.</p>
            </a>
            <a href="https://agendaparkingowa.pl/" target="_blank" rel="external" class="mpr-link-card">
                <div class="mpr-link-card-title">Miejska Agenda Parkingowa &rarr;</div>
                <p>Cztery zmiany w przepisach, po których donoszenie nie będzie potrzebne.</p>
            </a>
        </div>
    </section>

    <section class="mpr-section mpr-faq">
        <h2 class="mpr-section-title">FAQ</h2>
        <div class="mpr-faq-list">
            <details class="mpr-faq-item">
                <summary>
                    Czy będę {{ config.sex.anonimowa }}?
                    <svg class="mpr-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="mpr-faq-answer">
                    <p>Sprawca wykroczenia ma prawo poznać jedynie twoje imię i nazwisko. Twój adres
                        zamieszkania jest chroniony. Poradnik z różnymi formami zgłaszania wykroczeń
                        z uwzględnieniem anonimowości znajdziesz w
                        <a href="/jak-zglosic-nielegalne-parkowanie.html">poradniku zgłaszania</a>.
                        Więcej o bezpieczeństwie swoich danych przeczytasz na stronie
                        <a href="/bezpieczenstwo.html">Bezpieczeństwo</a>.</p>
                </div>
            </details>
            <details class="mpr-faq-item">
                <summary>
                    Czy będę {{ config.sex.wezwana }} do złożenia zeznań?
                    <svg class="mpr-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="mpr-faq-answer">
                    <p>To zależy od miasta, w którym zgłaszasz. Dowiesz się więcej na stronie
                        <a href="/przesluchanie.html">Czy straż miejska wezwie mnie na przesłuchanie?</a></p>
                </div>
            </details>
            <details class="mpr-faq-item">
                <summary>
                    Czy są inne sposoby?
                    <svg class="mpr-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="mpr-faq-answer">
                    <p>Oczywiście. Przeczytaj pełen
                        <a href="/jak-zglosic-nielegalne-parkowanie.html">poradnik zgłaszania nielegalnego parkowania</a>.</p>
                </div>
            </details>
            <a class="mpr-faq-item mpr-faq-more" href="/faq.html">
                Masz inne pytania?
            </a>
        </div>
    </section>

    <section class="mpr-section mpr-section-tinted">
        <h2 class="mpr-section-title">Chcesz nam pomóc?</h2>
        <div class="mpr-cards mpr-cards-3">
            <div class="mpr-card mpr-support-card">
                <span class="mpr-card-icon mpr-icon-tertiary">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.65 12 20 12 20z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3>Patronite</h3>
                <p>Praca nad serwisem i lobbing nad zmianą przepisów to czas i pieniądze. Dołącz do {{ config.stats.patrons }} Patronek
                    i Patronów i pomóż nam działać stabilnie.</p>
                <a href="/patronite.html" class="mpr-button mpr-button-outline">Wspieram</a>
            </div>
            <div class="mpr-card mpr-support-card">
                <span class="mpr-card-icon mpr-icon-secondary">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h2l7 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M17 9a4 4 0 0 1 0 6"/></svg>
                </span>
                <h3>Społeczność</h3>
                <p>Dołącz do społeczności osób, którym zależy na wspólnej przestrzeni.</p>
                <a href="https://www.facebook.com/groups/patologiaparkingowa/" target="_blank" rel="external"
                    class="mpr-button mpr-button-outline">Grupa na FB</a>
            </div>
            <div class="mpr-card mpr-support-card">
                <span class="mpr-card-icon mpr-icon-primary">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/></svg>
                </span>
                <h3>Programiści</h3>
                <p>Uprzejmie Donoszę to projekt open-source. Dołącz do nas na GitHubie i pomóż rozwijać aplikację.</p>
                <a href="https://github.com/uprzejmiedonosze/uprzejmiedonosze/" target="_blank" rel="external"
                    class="mpr-button mpr-button-outline">GitHub</a>
            </div>
        </div>
    </section>

</div>

{% endblock %}
