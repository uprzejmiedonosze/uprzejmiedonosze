{% set leftButton = 'menu' %}
{# SITEMAP-PRIORITY:1.0 #}

{% set mainClass = 'mainPage' %}

{% extends "base.html.twig" %}

{% block headIncludes %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@600;700&family=Inter:wght@400;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap">
{% endblock %}

{% block main %}

<div class="main-page-redesign">

    <section class="mpr-hero">
        <div class="mpr-hero-copy">
            <h2>Pomagamy walczyć z nielegalnym parkowaniem!</h2>
            <p class="mpr-lead">
                Denerwuje Cię wieczny bałagan na chodnikach, ścieżkach i drogach?
                Dołącz do ponad <strong>{{ (config.stats.users / 1000) | round(0) }} tysięcy</strong>
                osób działających na rzecz uzywalnienia polskich miast.
            </p>
            <div class="mpr-cta-row">
                <a href="/app" class="mpr-button mpr-button-primary">
                    Przejdź do aplikacji
                </a>
                <a href="#jak-to-dziala" class="mpr-button mpr-button-secondary">
                    Jak to działa?
                </a>
            </div>
        </div>
        <div class="mpr-hero-media" id="jak-to-dziala">
            <div class="video video-landscape">
                <video controls poster="img/ud-intro-desktop.png?width=800">
                    <source src="/img/video/ud-intro-desktop.mp4" type="video/mp4" />
                    <source src="/img/video/ud-intro-desktop.webm" type="video/webm" />
                    <source src="/img/video/ud-intro-desktop.ogv" type="video/ogg" />
                    <p>
                        Twoja przeglądarka nie wspiera odtwarzania plików wideo.
                        <a href="/img/video/ud-intro-desktop.mp4">Pobierz film</a>.
                    </p>
                </video>
            </div>
            <div class="video video-portrait">
                <video controls poster="/img/ud-intro-mobile.png?width=720">
                    <source src="/img/video/ud-intro-mobile.mp4" type="video/mp4" />
                    <source src="/img/video/ud-intro-mobile.webm" type="video/webm" />
                    <source src="/img/video/ud-intro-mobile.ogv" type="video/ogg" />
                    <p>
                        Twoja przeglądarka nie wspiera odtwarzania plików wideo.
                        <a href="/img/video/ud-intro-mobile.mp4">Pobierz film</a>.
                    </p>
                </video>
            </div>
        </div>
    </section>

    <section class="mpr-section mpr-section-tinted">
        <h2 class="mpr-section-title">Poznaj aplikację UD</h2>
        <div class="mpr-cards mpr-cards-3">
            <div class="mpr-card mpr-card-primary">
                <span class="material-symbols-outlined mpr-card-icon">receipt_long</span>
                <h3>Wygodne automatyczne generowanie i wysyłka</h3>
                <p>System sam generuje odpowiednie pisma i formularze na podstawie zdjęć i lokalizacji.
                    Nie musisz znać paragrafów.</p>
                <a href="/jak-zglosic-nielegalne-parkowanie.html">Czytaj dalej</a>
            </div>
            <div class="mpr-card mpr-card-secondary">
                <span class="material-symbols-outlined mpr-card-icon">local_police</span>
                <h3>W pełni poprawne i kompletne zgłoszenie</h3>
                <p>Zgłoszenie trafia do właściwego oddziału Straży Miejskiej lub Policji,
                    zgodnie z obowiązującymi przepisami.</p>
                <a href="/przepisy.html">Czytaj dalej</a>
            </div>
            <div class="mpr-card mpr-card-tertiary">
                <span class="material-symbols-outlined mpr-card-icon">public</span>
                <h3>Ogólnopolski zasięg &ndash; jesteśmy w ponad {{ config.stats.sm }} miejscowościach</h3>
                <p>Wysyłamy zgłoszenia do właściwych służb w całej Polsce, ułatwiając życie
                    Tobie i służbom.</p>
                <a href="/statystyki.html">Czytaj dalej</a>
            </div>
        </div>
    </section>

    <section class="mpr-section mpr-faq">
        <h2 class="mpr-section-title">FAQ</h2>
        <div class="mpr-faq-list">
            <a class="mpr-faq-item" href="/faq.html">
                Czy będę anonimowy?
                <span class="material-symbols-outlined">expand_more</span>
            </a>
            <a class="mpr-faq-item" href="/faq.html#swiadek">
                Czy będę wzywany do złożenia zeznań?
                <span class="material-symbols-outlined">expand_more</span>
            </a>
            <a class="mpr-faq-item" href="#zabijmy-aplikacje">
                Czy są inne sposoby?
                <span class="material-symbols-outlined">expand_more</span>
            </a>
            <a class="mpr-faq-item mpr-faq-more" href="/faq.html">
                Mam inne pytania?
            </a>
        </div>
    </section>

    <section class="mpr-section mpr-mission" id="zabijmy-aplikacje">
        <div class="mpr-mission-photo">SN</div>
        <div class="mpr-mission-copy">
            <h2>Co oprócz aplikacji? Zabijmy razem aplikację</h2>
            <div class="mpr-mission-items">
                <div class="mpr-mission-item">
                    <span class="material-symbols-outlined">gavel</span>
                    <div>
                        <h3>Działania prawne</h3>
                        <p>Napisz <a href="/napisz-pismo-do-polityka.html">pismo do polityka</a>
                            w trzy minuty i przełóż swoją frustrację w realne działania. Wspieramy
                            też <a href="https://agendaparkingowa.pl/" target="_blank" rel="external">Miejską
                            Agendę Parkingową</a>, by zmieniać przepisy systemowo.</p>
                    </div>
                </div>
                <div class="mpr-mission-item">
                    <span class="material-symbols-outlined">campaign</span>
                    <div>
                        <h3>Działania medialne, nagłaśnianie, prowokacje &ndash; robię szum</h3>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Treść do
                            uzupełnienia &ndash; opis działań medialnych i nagłaśniających.</p>
                    </div>
                </div>
                <div class="mpr-mission-item">
                    <span class="material-symbols-outlined">forum</span>
                    <div>
                        <h3>Działania internetowe, stop cham</h3>
                        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Treść do
                            uzupełnienia &ndash; opis działań internetowych.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mpr-section mpr-section-tinted">
        <h2 class="mpr-section-title">Chcesz nas wspomóc?</h2>
        <div class="mpr-cards mpr-cards-3">
            <div class="mpr-card mpr-support-card">
                <span class="material-symbols-outlined mpr-card-icon mpr-icon-tertiary">volunteer_activism</span>
                <h3>Patronite</h3>
                <p>Utrzymanie serwerów kosztuje. Dołącz do {{ config.stats.patrons }} Patronek
                    i Patronów i pomóż nam działać stabilnie.</p>
                <a href="/patronite.html" class="mpr-button mpr-button-outline">Wspieram</a>
            </div>
            <div class="mpr-card mpr-support-card">
                <span class="material-symbols-outlined mpr-card-icon mpr-icon-secondary">campaign</span>
                <h3>Rozgłos</h3>
                <p>Powiedz znajomym. Im nas więcej, tym większa presja na służby.</p>
                <a href="https://www.facebook.com/groups/patologiaparkingowa/" target="_blank" rel="external"
                    class="mpr-button mpr-button-outline">Udostępnij</a>
            </div>
            <div class="mpr-card mpr-support-card">
                <span class="material-symbols-outlined mpr-card-icon mpr-icon-primary">code</span>
                <h3>Programiści</h3>
                <p>Jesteśmy open-source. Dołącz do nas na GitHubie i pomóż rozwijać aplikację.</p>
                <a href="https://github.com/uprzejmiedonosze/uprzejmiedonosze/" target="_blank" rel="external"
                    class="mpr-button mpr-button-outline">GitHub</a>
            </div>
        </div>
    </section>

</div>

{% endblock %}
