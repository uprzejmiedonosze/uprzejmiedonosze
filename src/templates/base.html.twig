{% if shortTitle is not defined %}
    {% set shortTitle = title ?? 'Uprzejmie Donoszę' %}
{% endif %}

{% if title is defined %}
    {% set title = title ~ ' | Uprzejmie Donoszę' %}
{% else %}
    {% set title = 'Uprzejmie Donoszę' %}
{% endif %}

{# Every page defaults to the redesigned header/width now; a template can
   still opt out by setting redesignClass = '' itself before extending. #}
{% set redesignClass = redesignClass ?? 'rd25' %}

{# ---------------------------------------------------------------------------
   Layout presets. Każda strona deklaruje tylko `{% set layout = '...' %}`,
   a wszystkie flagi layoutu wyprowadzamy z jednego presetu. Per-page override
   nadal wygrywa (dzięki `??`), więc wyjątki są możliwe bez łamania systemu.
     links  – linki nawigacyjne w górnym navbarze (desktop)
     cta    – przycisk CTA w navbarze
     sidebar– boczna kolumna (rail na desktopie / menu)
     focus  – wycentrowana, jednokolumnowa treść (proces)
     tabbar – dolny pasek zakładek (sekcja /app na mobile)
     menu   – hamburger z nawigacją na mobile
     footer – stopka serwisu
   --------------------------------------------------------------------------- #}
{% set layout = layout ?? 'static' %}
{% set _presets = {
    'main':   {links: true,  cta: true,  sidebar: false, focus: false, tabbar: false, menu: true,  footer: true},
    'static': {links: true,  cta: true,  sidebar: false, focus: false, tabbar: false, menu: true,  footer: true},
    'app':    {links: false, cta: true,  sidebar: true,  focus: false, tabbar: true,  menu: false, footer: false},
    'focus':  {links: false, cta: false, sidebar: false, focus: true,  tabbar: false, menu: false, footer: false},
    'auth':   {links: false, cta: false, sidebar: false, focus: true,  tabbar: false, menu: false, footer: false},
    'system': {links: false, cta: false, sidebar: false, focus: true,  tabbar: false, menu: false, footer: false},
    'public': {links: true,  cta: true,  sidebar: false, focus: false, tabbar: false, menu: true,  footer: true},
} %}
{% set _p = _presets[layout] ?? _presets['static'] %}
{% set hideNavbarLinks = hideNavbarLinks ?? (not _p.links) %}
{% set hideNavbarCta   = hideNavbarCta   ?? (not _p.cta) %}
{% set hasSidebar      = hasSidebar      ?? _p.sidebar %}
{% set focusLayout     = focusLayout     ?? _p.focus %}
{% set showAppNav      = showAppNav      ?? _p.tabbar %}
{% set showMenu        = showMenu        ?? _p.menu %}
{# hamburger (menu.scss) renderowany przez _menu.html.twig gdy leftButton == 'menu' #}
{% set leftButton      = leftButton      ?? (showMenu ? 'menu' : '') %}
{% set _showFooter     = (_p.footer and not dialog) %}

{# Poza /app hamburger przejmuje treść sidebara strony (spis treści /
   „Przeczytaj także”) zamiast pełnej, legacy nawigacji serwisu — analogicznie
   do tego, jak /app niesie w overlayu ten sam _app-menu co desktopowy rail.
   Blok `sidebar` renderujemy do zmiennej TU, bo tylko base ma do niego dostęp
   (zagnieżdżony _menu.html.twig już nie). Pusto (np. homepage bez sidebara) =>
   _menu.html.twig spada na publiczną nawigację headera (_public-nav). #}
{% set sidebarNav %}{% if layout != 'app' %}{{ block('sidebar') }}{% endif %}{% endset %}

<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1,
            maximum-scale=1, user-scalable=no, shrink-to-fit=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="mobile-web-app-capable" content="yes">
        <title>{{ title }}</title>
        <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
        <link rel="apple-touch-icon" sizes="57x57" href="/img/apple-touch-icon-57x57.png" />
        <link rel="apple-touch-icon" sizes="72x72" href="/img/apple-touch-icon-72x72.png" />
        <link rel="apple-touch-icon" sizes="76x76" href="/img/apple-touch-icon-76x76.png" />
        <link rel="apple-touch-icon" sizes="114x114" href="/img/apple-touch-icon-114x114.png" />
        <link rel="apple-touch-icon" sizes="120x120" href="/img/apple-touch-icon-120x120.png" />
        <link rel="apple-touch-icon" sizes="144x144" href="/img/apple-touch-icon-144x144.png" />
        <link rel="apple-touch-icon" sizes="152x152" href="/img/apple-touch-icon-152x152.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon-180x180.png" />
        <link rel="manifest" href="/manifest.json">

        <meta name="theme-color" content="#009C7F">
        <meta property="og:image"
            content="{{ BASE_URL }}{{ image ?? 'img/uprzejmiedonosze.png' }}" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description"
            content="{{ description ?? 'Uprzejmie Donoszę pozwala na informowanie Straży Miejskiej lub Policji o sytuacjach, które wpływają na komfort i bezpieczeństwo pieszych. Maksymalnie upraszcza wykonanie poprawnego zgłoszenia, i przekazanie go do SM.' }}" />
        <meta property="og:url" content="{{ BASE_URL }}{% if config.auth is not defined %}{{ general.uri }}{% endif %}" />
        <meta property="og:locale" content="pl_PL" />
        <meta property="og:type" content="website" />
        <meta property="fb:app_id" content="1299217686854263" />
        <meta name="google" content="nopagereadaloud">
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

        <link rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer"
            href="/css/index3.css?{{ CSS_HASH }}">

        {% if not general.isProd %}
        <meta name="robots" content="noindex, nofollow">
        {% endif %}
        <script>
            var _paq = window._paq = window._paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            {% if general.isProd %}
            (function() {
                var u = "//matomo.nieradka.com/";
                _paq.push(['setTrackerUrl', u + 'matomo.php']);
                _paq.push(['setSiteId', '{{ general.matomoSiteId }}']);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.async = true;
                g.src = u + 'matomo.js';
                s.parentNode.insertBefore(g, s);
            })();
            {% endif %}
        </script>


        {% block headIncludes %}
        {% if not general.isLoggedIn and layout != 'auth' and not dialog %}
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script src="/js/google-one-tap.js?{{ JS_HASH }}"></script>
        {% endif %}
        {% endblock %}
    </head>
    <body class="index {{ mainClass ?? '' }} {{ redesignClass ?? '' }}{% if layout == 'app' or (appShell ?? false) %} app-shell{% endif %}">
        <div data-role="page" class="ui-page" {{iff(dialog,'data-dialog="true"')}}>
        {% include('header.html.twig') %}
            <div data-role="main" class="ui-content {{ mainClass ?? '' }} {{ redesignClass ?? '' }} {% if dialog %}dialog{% endif %}">
        <div class="mpr-layout{% if hasSidebar ?? false %} mpr-layout--sidebar{% elseif focusLayout ?? false %} mpr-layout--focus{% endif %}">
            <div class="mpr-article">
        {% block main %}{% endblock %}
            </div>
        {% block sidebar %}
            {# domyślny rail sekcji /app: nawigacja app-menu (desktop) + opcjonalne
               panele strony (np. filtr statusów) w bloku sidebar_extra. Na mobile
               nawigację niesie hamburger (_app-menu, to samo źródło), więc
               .mpr-sidebar-nav chowamy — patrz layout.scss. Strony static/main
               nadpisują cały blok sidebar własnym TOC/related. #}
            {% if hasSidebar and layout == 'app' %}
            <aside class="mpr-sidebar mpr-sidebar--toc mpr-sidebar--app">
                <details class="mpr-sidebar-nav" open>
                    <summary>Menu</summary>
                    {% include('_app-menu.html.twig') %}
                </details>
                {% block sidebar_extra %}{% endblock %}
            </aside>
            {% endif %}
        {% endblock %}
        </div>
            </div> <!-- main -->
            <div id="toast"></div>
        {% if showAppNav ?? false %}
        {% include('_app-tabbar.html.twig') %}
        {% endif %}
        {% block footer %}
            {% if _showFooter %}
            <footer data-role="footer" class="{{ redesignClass ?? '' }}">

                <div class="grid3">
                    {% for columnKey, column in footerLinks ?? [] %}
                    <div>
                        <div class="header">{{ column.title }}</div>
                        {% for item in column.items %}
                        <a href="{{ item.href }}"{% if item.external ?? false %} rel="external" target="_blank"{% endif %}>{{ item.label }}</a>
                        {% endfor %}
                    </div>
                    {% endfor %}
                </div>
            </footer> <!-- footer -->
            {% endif %}
        {% endblock %}
        </div> <!-- page -->
    {% block jsIncludes %}
    <script src="/js/index3.js?{{ JS_HASH }}" user-number="{{ config.userNumber ?? 0 }}"></script>
    {% endblock %}
    </body>
</html>
