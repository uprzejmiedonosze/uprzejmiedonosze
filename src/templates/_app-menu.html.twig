<ul class="mpr-menu-list">
    <li><a {{ active(config.menu, 'app')|raw }} href="/app">Dashboard</a></li>
    <li><a {{ active(config.menu, 'nowe-zgloszenie')|raw }} href="/app/new">Nowe zgłoszenie</a></li>
    <li><a {{ active(config.menu, 'moje-zgloszenia')|raw }} href="/app/list">Moje zgłoszenia
        <span class="badge">{{ general.stats.active ?? 0 }}</span></a></li>
    {% if general.stats.confirmed is defined and general.stats.confirmed > 0 %}
    <li><a href="/app/send">Do wysłania
        <span class="badge">{{ general.stats.confirmed }}</span></a></li>
    {% endif %}
    {% if general.stats['confirmed-waiting'] is defined and general.stats['confirmed-waiting'] > 0 %}
    <li><a {{ active(config.menu, 'zapytaj-o-status')|raw }} href="/app/ask-for-status?update">Zapytaj o status
        <span class="badge">{{ general.stats['confirmed-waiting'] }}</span></a></li>
    {% endif %}
    <li><a {{ active(config.menu, 'mcp')|raw }} href="/mcp">Asystent AI/MCP</a></li>
    <li><a {{ active(config.menu, 'register')|raw }} href="/app/account?update">Edycja konta</a></li>
    <li class="menu-item-divider"><a href="/logout.html">Wyloguj się</a></li>
</ul>
