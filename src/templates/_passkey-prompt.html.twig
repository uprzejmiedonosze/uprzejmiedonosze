{# Server decides eligibility (registered, no passkey yet, not dismissed);
   passkey-prompt.js hides this if the browser doesn't support WebAuthn. #}
<div id="passkey-prompt" class="warning-header" hidden>
    <p>
        Możesz zalogować się szybciej — odciskiem palca, twarzą lub kodem PIN.
        <button type="button" id="passkey-prompt-add">Dodaj passkey</button>
        <button type="button" id="passkey-prompt-dismiss">Nie teraz</button>
    </p>
</div>
