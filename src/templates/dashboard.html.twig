{% extends "base.html.twig" %}

{% block headIncludes %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block main %}
    <div class="dashboard-header">
        <h1>Dashboard Telemetryczny</h1>
        <p>Przegląd statystyk operacyjnych</p>
    </div>

    <div class="dashboard-container">
        <!-- 2. Daily Growth -->
        <div class="chart-box">
            <h3>Statystyki (ostatnie 30 dni)</h3>
            <canvas id="dailyChart"></canvas>
        </div>

        <!-- 2b. Hourly Growth -->
        <div class="chart-box">
            <h3>Statystyki (ostatnie 24 godzin)</h3>
            <canvas id="hourlyChart"></canvas>
        </div>

        <!-- 3. Delivery Status -->
        <div class="chart-box">
            <h3>Statusy Dostarczeń (Mailgun)</h3>
            {% set deliveryTotal = 0 %}
            {% for d in deliveryStats %}{% set deliveryTotal = deliveryTotal + d.cnt %}{% endfor %}
            <table class="stats-table">
                <thead>
                    <tr><th>Status</th><th>Liczba</th><th>%</th></tr>
                </thead>
                <tbody>
                    {% for d in deliveryStats %}
                        <tr>
                            <td>{{ d.status ?: 'Nieznany' }}</td>
                            <td>{{ d.cnt }}</td>
                            <td>{{ deliveryTotal > 0 ? (d.cnt / deliveryTotal * 100)|round(1) : 0 }}%</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3">Brak danych o dostarczeniach.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- 4. Top Errors -->
        <div class="chart-box">
            <h3>Top 5 Błędów Wysyłki</h3>
            <table class="stats-table">
                <thead>
                    <tr><th>Powód</th><th>Liczba</th><th>Ostatnie wystąpienie</th></tr>
                </thead>
                <tbody>
                    {% for err in deliveryErrors %}
                        <tr><td>{{ err.reason ?: 'Nieznany' }}</td><td>{{ err.cnt }}</td><td>{{ err.last_seen ? err.last_seen|slice(0, 16) : '—' }}</td></tr>
                    {% else %}
                        <tr><td colspan="3">Brak danych o błędach.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- 5. App Errors -->
        <div class="chart-box">
            <h3>Top 5 Błędów Aplikacji</h3>
            <table class="stats-table">
                <thead>
                    <tr><th>Błąd</th><th>Liczba</th><th>Ostatnie wystąpienie</th></tr>
                </thead>
                <tbody>
                    {% for err in appErrors %}
                        <tr><td>{{ err.msg }}</td><td>{{ err.cnt }}</td><td>{{ err.last_seen ? err.last_seen|slice(0, 16) : '—' }}</td></tr>
                    {% else %}
                        <tr><td colspan="3">Brak błędów aplikacji.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Data from PHP
        const dailyData = {{ dailyStats|json_encode|raw }};
        const hourlyData = {{ hourlyStats|json_encode|raw }};

        // Daily Chart
        new Chart(document.getElementById('dailyChart'), {
            type: 'line',
            data: {
                labels: dailyData.map(d => d.day),
                datasets: [
                    {
                        label: 'Wysłane Aplikacje',
                        data: dailyData.map(d => d.sent),
                        borderColor: '#009C7F',
                        backgroundColor: 'rgba(0, 156, 127, 0.1)',
                        fill: true,
                        yAxisID: 'y'
                    },
                    {
                        label: 'App started / Visitor entry (%)',
                        data: dailyData.map(d => d.entries > 0 ? (d.started / d.entries * 100).toFixed(1) : 0),
                        borderColor: '#FFD700',
                        backgroundColor: 'transparent',
                        borderDash: [5, 5],
                        yAxisID: 'y1',
                        tension: 0.3
                    },
                    {
                        label: 'App sent / App started (%)',
                        data: dailyData.map(d => d.started > 0 ? (d.sent / d.started * 100).toFixed(1) : 0),
                        borderColor: '#FF4500',
                        backgroundColor: 'transparent',
                        borderDash: [2, 2],
                        yAxisID: 'y1',
                        tension: 0.3
                    }
                ]
            },
            options: {
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Liczba aplikacji' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        min: 0,
                        max: 100,
                        title: { display: true, text: 'Konwersja (%)' },
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });

        // Hourly Chart
        new Chart(document.getElementById('hourlyChart'), {
            type: 'line',
            data: {
                labels: hourlyData.map(d => d.hour.substr(11, 5)),
                datasets: [
                    {
                        label: 'Wysłane Aplikacje',
                        data: hourlyData.map(d => d.sent),
                        borderColor: '#009C7F',
                        backgroundColor: 'rgba(0, 156, 127, 0.1)',
                        fill: true,
                        yAxisID: 'y'
                    },
                    {
                        label: 'App started / Visitor entry (%)',
                        data: hourlyData.map(d => d.entries > 0 ? (d.started / d.entries * 100).toFixed(1) : 0),
                        borderColor: '#FFD700',
                        backgroundColor: 'transparent',
                        borderDash: [5, 5],
                        yAxisID: 'y1',
                        tension: 0.3
                    },
                    {
                        label: 'App sent / App started (%)',
                        data: hourlyData.map(d => d.started > 0 ? (d.sent / d.started * 100).toFixed(1) : 0),
                        borderColor: '#FF4500',
                        backgroundColor: 'transparent',
                        borderDash: [2, 2],
                        yAxisID: 'y1',
                        tension: 0.3
                    }
                ]
            },
            options: {
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Liczba aplikacji' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        min: 0,
                        max: 100,
                        title: { display: true, text: 'Konwersja (%)' },
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });

</script>
{% endblock %}
