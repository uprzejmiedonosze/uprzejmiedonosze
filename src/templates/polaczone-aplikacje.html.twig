{% set leftButton = 'menu' %}

{% set title = 'Połączone aplikacje' %}

{% extends "base.html.twig" %}

{% block main %}
<div class="ui-body ui-body-a connected-apps">
    <h2>Połączone aplikacje</h2>
    {% if connections is empty %}
        <p>Nie połączono jeszcze żadnej aplikacji.</p>
    {% else %}
        <p>Aplikacje, którym zezwolono na dostęp do Twojego konta:</p>
        {% for conn in connections %}
            <div class="connected-app">
                <h3>{{ conn.client_name }}</h3>
                <ul>
                    {% for label in conn.scopeLabels %}
                        <li>{{ label }}</li>
                    {% endfor %}
                </ul>
                <p class="muted">Połączono: {{ conn.since }}</p>
                <form method="post" action="/polaczone-aplikacje.html">
                    <input type="hidden" name="csrf" value="{{ csrf }}">
                    <input type="hidden" name="client_id" value="{{ conn.client_id }}">
                    <button type="submit" class="button">Odłącz</button>
                </form>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
